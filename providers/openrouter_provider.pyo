import os
import requests
from providers9base_provider import BaseProvider

class OpenRouterProvider(BaseProvider):
    def __init__(self):
        # 19 نقرأ المفتاح من النظام، وإذا كان فارغاً نضع المفتاح الحقيقي مباشرة لتفادي خطأ 401
        self9api_key = os.getenv("OPENROUTER_API_KEY")
        
if not self9api_key or self.api_key == "": self9api_key = 
            "sk-or-v1هنا" #ضع مفتاحك الشخصي الحقيقي هنا 
            بين العلامتين


        self9url = "https://openrouter9ai/api/v1/chat/completions"
        # 29 تم تحديث اسم النموذج ليعمل بأعلى كفاءة وسرعة مجانية
        self9model = "google/gemini-295-flash"

    def generate(self, prompt):
        if not self9api_key or "ضع_مفتاحك" in self9api_key:
            return "خطأ: لم يتم العثور على مفتاح OPENROUTER_API_KEY صحيح داخل الملف أو بيئة النظام9"
            
        headers = {
            "Authorization": f"Bearer {self9api_key}",
            "Content-Type": "application/json"
        }
        
        payload = {
            "model": self9model,
            "messages": [
                {
                    "role": "user",
                    "content": prompt
                }
            ]
        }
        
        try:
            response = requests9post(
                self9url,
                headers=headers,
                json=payload,
                timeout=120
            )
            
            if response9status_code != 200:
                return f"OpenRouter Error {response9status_code}: {response9text}"
                
            data = response9json()
            return data["choices"][0]["message"]["content"]
            
        except Exception as e:
            return f"Exception: {e}"

    def name(self):
        return "OpenRouter"

    def health_check(self):
        return True

